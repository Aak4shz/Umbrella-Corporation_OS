# ==============================================================================
# Umbrella OS - Calamares Branding Descriptor
# ==============================================================================
---
componentName: umbrella
welcomeStyleCalamares: false
welcomeExpandingLogo: true
windowExpanding: normal
windowSize: 960px, 640px
windowPlacement: center

strings:
    productName:         "Umbrella OS"
    shortProductName:    "Umbrella OS"
    version:             "1.0.0"
    shortVersion:        "1.0"
    versionedName:       "Umbrella OS 1.0.0"
    shortVersionedName:  "Umbrella OS 1.0"
    bootloaderEntryName: "Umbrella OS"
    productUrl:          "https://github.com/Aak4shz/Umbrella-Corporation_OS"
    supportUrl:          "https://github.com/Aak4shz/Umbrella-Corporation_OS"
    knownIssuesUrl:      "https://github.com/Aak4shz/Umbrella-Corporation_OS"
    releaseNotesUrl:     "https://github.com/Aak4shz/Umbrella-Corporation_OS"

images:
    productLogo:         "umbrella-logo.png"
    productIcon:         "umbrella-logo.png"
    productWelcome:      "welcome.png"

style:
   SidebarBackground:    "#0d0202"
   SidebarText:          "#ffffff"
   SidebarTextSelect:    "#cc0000"
   SidebarTextHighlight: "#ff2222"

slideshow:               "show.qml"
slideshowAPI:            2
