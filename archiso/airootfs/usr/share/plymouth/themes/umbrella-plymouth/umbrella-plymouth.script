# ════════════════════════════════════════════════════════════════════
# UMBRELLA OS — Plymouth Boot Animation Script
# Red Queen Biohazard System Boot Sequence
# ════════════════════════════════════════════════════════════════════

# Set dark background (#0A0A0A)
Window.SetBackgroundTopColor(0.04, 0.04, 0.04);
Window.SetBackgroundBottomColor(0.02, 0.02, 0.02);

screen_width = Window.GetWidth();
screen_height = Window.GetHeight();

# Load 36 rotated Biohazard emblem frames
NUM_FRAMES = 36;
for (i = 0; i < NUM_FRAMES; i++) {
    spinner_images[i] = Image("spinner-" + i + ".png");
}

logo_sprite = Sprite();
current_frame = 0;

# Position logo sprite in center
if (spinner_images[0]) {
    logo_width = spinner_images[0].GetWidth();
    logo_height = spinner_images[0].GetHeight();
    logo_x = (screen_width / 2) - (logo_width / 2);
    logo_y = (screen_height / 2) - (logo_height / 2) - 60;
    
    logo_sprite.SetX(logo_x);
    logo_sprite.SetY(logo_y);
    logo_sprite.SetImage(spinner_images[0]);
}

# Title Text: UMBRELLA CORPORATION (CF Glitch City Font)
title_image = Image.Text("UMBRELLA CORPORATION", 1.0, 1.0, 1.0, 1.0, "CF Glitch City 22");
title_sprite = Sprite(title_image);
title_sprite.SetX((screen_width / 2) - (title_image.GetWidth() / 2));
title_sprite.SetY(logo_y + logo_height + 25);

# Percentage Text Sprite Setup (CF Glitch City Font)
percent_sprite = Sprite();

# Thick Rectangular Progress Bar Setup (100% Upload Style)
BAR_WIDTH = 460;
BAR_HEIGHT = 28;
bar_x = (screen_width / 2) - (BAR_WIDTH / 2);
bar_y = logo_y + logo_height + 120;

# Outer crimson border box
bar_border_img = Image.Rectangle(BAR_WIDTH + 6, BAR_HEIGHT + 6, 0.8, 0.0, 0.0, 1.0);
bar_border_sprite = Sprite(bar_border_img);
bar_border_sprite.SetX(bar_x - 3);
bar_border_sprite.SetY(bar_y - 3);

# Inner dark trough box
bar_bg_img = Image.Rectangle(BAR_WIDTH, BAR_HEIGHT, 0.05, 0.05, 0.05, 1.0);
bar_bg_sprite = Sprite(bar_bg_img);
bar_bg_sprite.SetX(bar_x);
bar_bg_sprite.SetY(bar_y);

# Crimson laser progress fill sprite
bar_fill_sprite = Sprite();
bar_fill_sprite.SetX(bar_x + 2);
bar_fill_sprite.SetY(bar_y + 2);

# Status Message Sprite
status_sprite = Sprite();

fun update_progress(duration, progress) {
    # Update progress fill width
    fill_w = Math.Int((BAR_WIDTH - 4) * progress);
    if (fill_w < 2) fill_w = 2;
    if (fill_w > (BAR_WIDTH - 4)) fill_w = BAR_WIDTH - 4;
    
    fill_img = Image.Rectangle(fill_w, BAR_HEIGHT - 4, 1.0, 0.0, 0.0, 1.0);
    bar_fill_sprite.SetImage(fill_img);

    # Update percentage text in CF Glitch City font
    pct_val = Math.Int(progress * 100);
    pct_img = Image.Text(pct_val + " %", 1.0, 0.0, 0.0, 1.0, "CF Glitch City 24");
    if (pct_img) {
        percent_sprite.SetImage(pct_img);
        percent_sprite.SetX((screen_width / 2) - (pct_img.GetWidth() / 2));
        percent_sprite.SetY(bar_y - pct_img.GetHeight() - 14);
    }
}

fun update_status(text) {
    # Comment lines removed
}

fun refresh_callback() {
    # Advance spinner frame
    current_frame = (current_frame + 1) % NUM_FRAMES;
    if (spinner_images[current_frame]) {
        logo_sprite.SetImage(spinner_images[current_frame]);
    }
}

Plymouth.SetRefreshFunction(refresh_callback);
Plymouth.SetBootProgressFunction(update_progress);
Plymouth.SetUpdateStatusFunction(update_status);

# Fallback Password / Message hooks
fun display_password_callback(prompt, bullets) {
    prompt_img = Image.Text(prompt, 1.0, 0.2, 0.2, 1.0, "Sans Bold 11");
    status_sprite.SetImage(prompt_img);
    status_sprite.SetX((screen_width / 2) - (prompt_img.GetWidth() / 2));
    status_sprite.SetY(bar_y + BAR_HEIGHT + 16);
}

Plymouth.SetDisplayPasswordFunction(display_password_callback);
